@using POEM.Model.Model.Report
@model List<SKUReportDto>

@{
    Layout = null;

    string price = ViewBag.Price;
}


<!DOCTYPE html>

<html>

<head>

    <style>

        body {
            font-family: Arial;
            font-size: 11px;
        }


        .header {
            width: 100%;
            font-size: 15px;
            font-weight: bold;
            margin-top:20px;
            margin-bottom: 15px;
        }


        .card-box {
            width: 31%;
            height: 360px;
            float: left;
            margin: 5px;
            border: 1px solid #444;
            page-break-inside: avoid;
        }


        .image-box {
            text-align: center;
            padding: 5px;
        }


            .image-box img {
                width: 120px;
                height: 120px;
                object-fit: contain;
            }


        table {
            width: 100%;
            border-collapse: collapse;
        }


        th {
            width: 40%;
            text-align: left;
        }


        th, td {
            border: 1px solid #555;
            padding: 3px;
            word-break: break-word;
        }


        ul {
            margin: 0;
            padding-left: 12px;
        }


        .clear {
            clear: both;
        }


        .page-break {
            page-break-after: always;
        }


        
    </style>


</head>


<body>



    <div class="header">

        Company :
        @(Model.Any() ? Model.FirstOrDefault().CompanyName : "")


        <span style="float:right">

            Date :
            @DateTime.Now.ToString("dd-MM-yyyy")

        </span>


    </div>




    @for (int i = 0; i < Model.Count; i++)
    {

        var item = Model[i];


        decimal? semiPrice = 0;
        decimal? centerPrice = 0;


        if (price == "1")
        {
            semiPrice = item.SemiPrice1;
            centerPrice = item.CenterPrice1;
        }
        else if (price == "2")
        {
            semiPrice = item.SemiPrice2;
            centerPrice = item.CenterPrice2;
        }
        else if (price == "3")
        {
            semiPrice = item.SemiPrice3;
            centerPrice = item.CenterPrice3;
        }
        else if (price == "4")
        {
            semiPrice = item.SemiPrice4;
            centerPrice = item.CenterPrice4;
        }



        <div class="card-box">


            <div class="image-box">

                <img src="@Server.MapPath("~/Images/SKUImages/ring.png")" />

            </div>



            <table>


                <tr>

                    <th>Sku</th>

                    <td colspan="2">
                        @item.SKUNumber
                    </td>

                </tr>



                <tr>

                    <th>Metal</th>

                    <td colspan="2">
                        @item.Metal
                    </td>

                </tr>



                <tr>

                    <th>Semi Mount</th>

                    <td>
                        @item.SemiMount
                    </td>


                    <td>
                        $@semiPrice
                    </td>


                </tr>




                <tr>

                    <th>
                        Center Shape / Size
                    </th>


                    <td>
                        @item.CenterShapeSize
                    </td>


                    <td>
                        $@centerPrice
                    </td>


                </tr>





                <tr>

                    <th>
                        Total Weight
                    </th>


                    <td>
                        @item.TotalWeight
                    </td>


                    <td>
                        $@(semiPrice + centerPrice)
                    </td>


                </tr>





                <tr>

                    <th>
                        Finding
                    </th>


                    <td colspan="2">


                        @if (!string.IsNullOrEmpty(item.Findings))
                        {

                            var findings = item.Findings.Split('#');


                            if (findings.Length > 1)
                            {

                                <ul>

                                    @foreach (var f in findings)
                                    {

                                        <li>
                                            @f
                                        </li>

                                    }

                                </ul>

                            }
                            else
                            {
                                @item.Findings
                            }

                        }


                    </td>


                </tr>




                <tr>

                    <th>
                        Collection
                    </th>


                    <td colspan="2">
                        @item.Collection
                    </td>


                </tr>


            </table>


        </div>





        if ((i + 1) % 3 == 0)
        {
            <div class="clear"></div>
        }



        if ((i + 1) % 9 == 0)
        {
            <div class="page-break"></div>
        }


    }







</body>

</html>