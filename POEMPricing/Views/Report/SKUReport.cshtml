

@using POEM.Model.Model.Report
@using System.Globalization
@model List<SKUReportDto>

@{
    ViewBag.Title = "Thumbnail Proposal Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<h3>Thumbnail Proposal</h3>


<div class="card">

    <div class="card-header">
        Report Filter
    </div>


    <div class="card-body">


        <form method="get"
              action="@Url.Action("ThumbnailProposalReportSearch","Report")">


            <div class="row">


                <div class="col-md-2">

                    <label class="form-label">
                        Company
                    </label>

                    @Html.DropDownList(
                                                  "company",
                                                  new SelectList(
                                                       ViewBag.Companies,
                                                       "Key",
                                                       "Value",
                                                       ViewBag.SelectedCompany
                                                   ),
                                                  "",
                                                  new { @class = "form-select", id = "ddlCompany" })

                </div>




                <div class="col-md-2">

                    <label class="form-label">
                        Category
                    </label>

                    @Html.ListBox(
                                                     "category",
                                                     new MultiSelectList(
                                                         ViewBag.Categories,
                                                         "Key",
                                                         "Value",
                                                         ViewBag.SelectedCategories
                                                     ),
                                                     new
                                                     {
                                                         @class = "form-control",
                                                         id = "ddlCategory"
                                                     })

                </div>




                <div class="col-md-2">

                    <label class="form-label">
                        Sub Category
                    </label>

                    @Html.ListBox(
                                                      "subCategory",
                                                      new MultiSelectList(
                                                         ViewBag.SubCategories,
                                                         "Key",
                                                         "Value",
                                                         ViewBag.SelectedSubCategories
                                                      ),
                                                      new
                                                      {
                                                          @class = "form-control",
                                                          id = "ddlSubCategory"
                                                      })

                </div>




                <div class="col-md-2">

                    <label class="form-label">
                        Collection
                    </label>
                    @Html.ListBox(
                                                  "collection",
                                                  new MultiSelectList(
                                                      ViewBag.Collections,
                                                      "Key",
                                                      "Value",
                                                      ViewBag.SelectedCollections
                                                  ),
                                                  new
                                                  {
                                                      @class = "form-control",
                                                      id = "ddlCollection"
                                                  })

                </div>

                <div class="col-md-2">
                    <div class="mb-1">
                        <div class="d-flex align-items-center mb-2">
                            <label for="ddlSku" class="form-label mb-0">SKU</label>

                        </div>

                        <select id="ddlSku"
                                name="skus"
                                multiple
                                class="form-control">
                        </select>
                        <input type="hidden"
                               id="hdnSelectedSkus"
                               value="@string.Join(",", ViewBag.SelectedSkus ?? new List<string>())" />
                    </div>
                </div>

                <div class="col-md-2">

                    <label class="form-label">
                        Price
                    </label>

                    <select id="ddlPrice"
                            name="price"
                            class="form-select">

                        <option value=""></option>

                        <option value="1" @(Request["price"] == "1" ? "selected" : "")>
                            1
                        </option>

                        <option value="2" @(Request["price"] == "2" ? "selected" : "")>
                            2
                        </option>

                        <option value="3" @(Request["price"] == "3" ? "selected" : "")>
                            3
                        </option>

                        <option value="4" @(Request["price"] == "4" ? "selected" : "")>
                            4
                        </option>

                    </select>

                </div>


            </div>
            <div class="row mt-3">
                <div class="col-md-12 text-end">

                    <button type="submit"
                            id="btnSearch"
                            class="btn btn-primary"
                            disabled>
                        Search
                    </button>

                    <a href="@Url.Action("ThumbnailProposal","Report")"
                       class="btn btn-secondary">
                        Clear
                    </a>

                    <a id="btnPdf"
                       class="btn btn-danger disabled"
                       target="_blank"
                       href="#">
                        PDF
                    </a>

                </div>
            </div>



        </form>


    </div>

</div>

<div id="reportContainer">
    @if (ViewContext.RouteData.Values["action"].ToString() == "ThumbnailProposalReportSearch"
        && Model != null
        && Model.Any())
    {
        <div class="row mt-3 mb-2 ">

            <div class="col-md-6">
                <h5>
                    Company :
                    @Model.FirstOrDefault().CompanyName
                </h5>
            </div>

            <div class="col-md-6 text-end">
                <h5>
                    Date :
                    @DateTime.Now.ToString("dd-MM-yyyy")
                </h5>
            </div>

        </div>
    }
    <div class="row mt-3">


        @if (!string.IsNullOrEmpty(Request["company"])
            && !string.IsNullOrEmpty(Request["price"])
            && Model != null
            && Model.Any())
        {

            foreach (var item in Model)
            {


                <div class="col-md-4">

                    <div class="card mb-3 shadow-sm">


                        <!-- Image -->
                        <div class="text-center p-2">

                            <img src="~/Images/SKUImages/ring.png"
                                 style="width:200px;height:200px;object-fit:contain;" />

                        </div>



                        <table class="table table-bordered mb-0">


                            <tr>
                                <th>Sku</th>
                                <td colspan="2">
                                    @item.SKUNumber
                                </td>
                            </tr>


                            <tr>
                                <th>Metal</th>

                                <td colspan="2">
                                    @item.Metal
                                </td>
                            </tr>



                            <tr>

                                <th>Semi Mount</th>

                                <td>
                                    @item.SemiMount
                                </td>

                                <td>

                                    <span class="price-1">
                                        $@item.SemiPrice1
                                    </span>

                                    <span class="price-2">
                                        $@item.SemiPrice2
                                    </span>

                                    <span class="price-3">
                                        $@item.SemiPrice3
                                    </span>

                                    <span class="price-4">
                                        $@item.SemiPrice4
                                    </span>

                                </td>

                            </tr>




                            <tr>

                                <th>
                                    Center Shape | Size
                                </th>


                                <td>
                                    @item.CenterShapeSize
                                </td>


                                <td>

                                    <span class="price-1">
                                        $@item.CenterPrice1
                                    </span>

                                    <span class="price-2">
                                        $@item.CenterPrice2
                                    </span>

                                    <span class="price-3">
                                        $@item.CenterPrice3
                                    </span>

                                    <span class="price-4">
                                        $@item.CenterPrice4
                                    </span>

                                </td>

                            </tr>




                            <tr>

                                <th>Total Weight</th>


                                <td>
                                    @item.TotalWeight
                                </td>


                                <td>

                                    <span class="price-1">
                                        @((item.SemiPrice1 + item.CenterPrice1)
                                    ?.ToString("C", new CultureInfo("en-US")))
                                    </span>


                                    <span class="price-2">
                                        @((item.SemiPrice1 + item.CenterPrice1)
                                    ?.ToString("C", new CultureInfo("en-US")))
                                    </span>


                                    <span class="price-3">
                                        @((item.SemiPrice1 + item.CenterPrice1)
                                    ?.ToString("C", new CultureInfo("en-US")))
                                    </span>


                                    <span class="price-4">
                                        @((item.SemiPrice1 + item.CenterPrice1)
                                    ?.ToString("C", new CultureInfo("en-US")))
                                    </span>


                                </td>


                            </tr>




                            <tr>

                                <th>Finding</th>

                                <td colspan="2"
                                    style="word-break:break-word;">


                                    @if (!string.IsNullOrEmpty(item.Findings))
                                    {

                                        var findings = item.Findings.Split('#');


                                        if (findings.Length > 1)
                                        {

                                            <ul class="mb-0 ps-3">

                                                @foreach (var f in findings)
                                                {
                                                    <li>
                                                        @f
                                                    </li>
                                                }

                                            </ul>

                                        }
                                        else
                                        {
                                            @item.Findings
                                        }

                                    }


                                </td>


                            </tr>



                            <tr>

                                <th>Collection</th>


                                <td colspan="2">
                                    @item.Collection
                                </td>


                            </tr>


                        </table>


                    </div>

                </div>

            }

        }
        else if (!string.IsNullOrEmpty(Request["company"])
            && !string.IsNullOrEmpty(Request["price"]))
        {
            <div class="col-12">

                <div class="alert alert-warning">
                    No Records Found
                </div>

            </div>
        }


    </div>
</div>
<style>
    .select2-container {
        width: 100% !important;
    }

        .select2-container .select2-selection--multiple {
            min-height: 38px !important;
            border: 1px solid #ced4da !important;
            border-radius: .375rem !important;
            padding: .275rem .5rem !important;
        }

    .select2-container--default
    .select2-selection--multiple
    .select2-selection__choice {
        margin-top: 2px;
    }

    .select2-container--default
    .select2-selection--multiple
    .select2-selection__rendered {
        padding-left: 0;
    }
</style>

@section scripts
{
    <script>

    $(document).ready(function () {

        // Category
        $('#ddlCategory').select2({
            placeholder: '',
            width: '100%'
        });

        // Sub Category
        $('#ddlSubCategory').select2({
            placeholder: '',
            width: '100%'
        });

        // Collection
        $('#ddlCollection').select2({
            placeholder: '',
            width: '100%'
        });

        // SKU
        $('#ddlSku').select2({
            placeholder: '',
            width: '100%',
            minimumInputLength: 5,
            closeOnSelect: false,

            ajax: {
                url: '/api/sku/GetSkus',
                dataType: 'json',
                delay: 300,
                cache: true,
                traditional: true,

                data: function (params) {
                    return {
                        term: params.term,
                        company: $("#ddlCompany").val(),
                        category: $("#ddlCategory").val(),
                        subCategory: $("#ddlSubCategory").val(),
                        collection: $("#ddlCollection").val()
                    };
                },

                processResults: function (data) {
                    return {
                        results: $.map(data, function (item) {
                            return {
                                id: item.Value,
                                text: item.Text
                            };
                        })
                    };
                }
            }
        });


        // Restore selected SKUs after Search
        var selectedSkus =
            ($("#hdnSelectedSkus").val() || "")
                .split(',')
                .filter(x => x);

        $.each(selectedSkus, function (i, sku) {

            var option =
                new Option(
                    sku,
                    sku,
                    true,
                    true
                );

            $('#ddlSku').append(option);
        });

        $('#ddlSku').trigger('change');


        // Keep hidden field updated
        $('#ddlSku').on(
            'select2:select select2:unselect change',
            function () {

                $("#hdnSelectedSkus")
                    .val(
                        ($(this).val() || []).join(',')
                    );

                updatePdfUrl();
            });


        // Clear SKU when filters change
        $("#ddlCompany,#ddlCategory,#ddlSubCategory,#ddlCollection")
            .change(function () {

                $("#ddlSku")
                    .empty()
                    .trigger('change');

                $("#hdnSelectedSkus")
                    .val("");

                updatePdfUrl();
            });


        // Company / Price
        $("#ddlCompany,#ddlPrice")
            .change(function () {

                applyPriceFilter();
                checkSearchButton();
                updatePdfUrl();
            });


        applyPriceFilter();
        checkSearchButton();
        updatePdfUrl();

        if ($("#ddlCompany").val() != ""
            && $("#ddlPrice").val() != ""
            && $(".card").length > 1) {

            $("#btnPdf")
                .removeClass("disabled");
        }

    });


    function applyPriceFilter() {

        var price = $("#ddlPrice").val();

        $(".price-1,.price-2,.price-3,.price-4")
            .hide();

        if (price == "") {

            $(".price-1,.price-2,.price-3,.price-4")
                .show();
        }
        else {

            $(".price-" + price)
                .show();
        }
    }


    function checkSearchButton() {

        $("#btnSearch").prop(
            "disabled",
            $("#ddlCompany").val() == ""
            || $("#ddlPrice").val() == ""
        );
    }


    function updatePdfUrl() {

        var selectedSkus =
            ($("#hdnSelectedSkus").val() || "")
                .split(',')
                .filter(x => x);

        var url =
            '@Url.Action("ThumbnailProposalReportPdf", "Report")'
            + '?'
            + $.param({
                company: $("#ddlCompany").val(),
                category: $("#ddlCategory").val(),
                subCategory: $("#ddlSubCategory").val(),
                collection: $("#ddlCollection").val(),
                skus: selectedSkus,
                price: $("#ddlPrice").val()
            }, true);

        $("#btnPdf")
            .attr("href", url);
    }

        $('form').submit(function (e) {

            e.preventDefault();

            $.ajax({
                url: $(this).attr('action'),
                type: 'GET',
                data: $(this).serialize(),
                traditional: true,

                success: function (response) {

                    var html =
                        $('<div>')
                            .html(response)
                            .find('#reportContainer')
                            .html();

                    $('#reportContainer')
                        .html(html);

                    applyPriceFilter();

                    if ($(".card").length > 0) {
                        $("#btnPdf")
                            .removeClass("disabled");
                    }
                    else {
                        $("#btnPdf")
                            .addClass("disabled");
                    }
                }
            });
        });

    </script>
}

