@using POEM.Model.Model.Report
@using System.Globalization
@model List<SKUReportDto>

@{
    ViewBag.Title = "Thumbnail Proposal Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<h3>Thumbnail Proposal</h3>


<div class="card">

    <div class="card-header">
        Report Filter
    </div>


    <div class="card-body">


        <form method="get"
              action="@Url.Action("ThumbnailProposalReportSearch","Report")">


            <div class="row">


                <div class="col-md-2">

                    <label class="form-label">
                        Company
                    </label>

                    @Html.DropDownList(
                                                  "company",
                                                  new SelectList(
                                                       ViewBag.Companies,
                                                       "Key",
                                                       "Value",
                                                       ViewBag.SelectedCompany
                                                   ),
                                                  "",
                                                  new { @class = "form-select", id = "ddlCompany" })

                </div>




                <div class="col-md-2">

                    <label class="form-label">
                        Category
                    </label>

                    @Html.ListBox(
                        "category",
                        new MultiSelectList(
                            ViewBag.Categories,
                            "Key",
                            "Value",
                            ViewBag.SelectedCategories
                        ),
                        new
                        {
                            @class = "selectpicker",
                            id = "ddlCategory",
                            title = "Category",
                            data_live_search = "true",
                            data_selected_text_format = "count > 2",
                            data_actions_box = "true",
                            data_width = "100%"
                        })

                </div>




                <div class="col-md-2">

                    <label class="form-label">
                        Sub Category
                    </label>

                    @Html.ListBox(
                        "subCategory",
                        new MultiSelectList(
                           ViewBag.SubCategories,
                           "Key",
                           "Value",
                           ViewBag.SelectedSubCategories
                        ),
                        new
                        {
                            @class = "selectpicker",
                            id = "ddlSubCategory",
                            title = "Sub Category",
                            data_live_search = "true",
                            data_selected_text_format = "count > 2",
                            data_actions_box = "true",
                            data_width = "100%"
                        })

                </div>




                <div class="col-md-2">

                    <label class="form-label">
                        Collection
                    </label>
                    @Html.ListBox(
                        "collection",
                        new MultiSelectList(
                            ViewBag.Collections,
                            "Key",
                            "Value",
                            ViewBag.SelectedCollections
                        ),
                        new
                        {
                            @class = "selectpicker",
                            id = "ddlCollection",
                            title = "Collection",
                            data_live_search = "true",
                            data_selected_text_format = "count > 2",
                            data_actions_box = "true",
                            data_width = "100%"
                        })

                </div>

                <div class="col-md-2">
                    <div class="mb-1">
                        <label for="ddlSku" class="form-label">SKU</label>

                        <select id="ddlSku"
                                name="skus"
                                multiple
                                class="selectpicker"
                                title="Select SKU"
                                data-live-search="true"
                                data-selected-text-format="count > 2"
                                data-width="100%">
                            @if (ViewBag.SelectedSkus != null)
                            {
                                foreach (var sku in (IEnumerable<string>)ViewBag.SelectedSkus)
                                {
                                    <option value="@sku" selected>@sku</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-2">

                    <label class="form-label">
                        Price
                    </label>

                    <select id="ddlPrice"
                            name="price"
                            class="form-select">

                        <option value=""></option>

                        <option value="1" @(Request["price"] == "1" ? "selected" : "")>
                            1
                        </option>

                        <option value="2" @(Request["price"] == "2" ? "selected" : "")>
                            2
                        </option>

                        <option value="3" @(Request["price"] == "3" ? "selected" : "")>
                            3
                        </option>

                        <option value="4" @(Request["price"] == "4" ? "selected" : "")>
                            4
                        </option>

                    </select>

                </div>


            </div>
            <div class="row mt-3">
                <div class="col-md-12 text-end">

                    <span data-bs-toggle="tooltip"
                          title="Select Company and Price to Search">
                        <button type="submit"
                                id="btnSearch"
                                class="btn btn-primary"
                                disabled>
                            Search
                        </button>
                    </span>

                    <a href="@Url.Action("ThumbnailProposal","Report")"
                       class="btn btn-secondary">
                        Clear
                    </a>

                    <a id="btnPdf"
                       class="btn btn-danger disabled"
                       target="_blank"
                       href="#">
                        PDF
                    </a>

                </div>
            </div>



        </form>


    </div>

</div>

<div id="reportContainer">
    @if (ViewContext.RouteData.Values["action"].ToString() == "ThumbnailProposalReportSearch"
        && Model != null
        && Model.Any())
    {
        <div class="row mt-3 mb-2 ">

            <div class="col-md-6">
                <h5>
                    Company :
                    @Model.FirstOrDefault().CompanyName
                </h5>
            </div>

            <div class="col-md-6 text-end">
                <h5>
                    Date :
                    @DateTime.Now.ToString("dd-MM-yyyy")
                </h5>
            </div>

        </div>
    }
    <div class="row mt-3">


        @if (!string.IsNullOrEmpty(Request["company"])
            && !string.IsNullOrEmpty(Request["price"])
            && Model != null
            && Model.Any())
        {

            foreach (var item in Model)
            {


                <div class="col-md-4">

                    <div class="card mb-3 shadow-sm">


                        <!-- Image -->
                        <div class="text-center p-2">

                            <img src="~/Images/SKUImages/ring.png"
                                 style="width:200px;height:200px;object-fit:contain;" />

                        </div>



                        <table class="table table-bordered mb-0">


                            <tr>
                                <th>Sku</th>
                                <td colspan="2">
                                    @item.SKUNumber
                                </td>
                            </tr>


                            <tr>
                                <th>Metal</th>

                                <td colspan="2">
                                    @item.Metal
                                </td>
                            </tr>



                            <tr>

                                <th>Semi Mount</th>

                                <td>
                                    @item.SemiMount
                                </td>

                                <td>

                                    <span class="price-1">
                                        $@item.SemiPrice1
                                    </span>

                                    <span class="price-2">
                                        $@item.SemiPrice2
                                    </span>

                                    <span class="price-3">
                                        $@item.SemiPrice3
                                    </span>

                                    <span class="price-4">
                                        $@item.SemiPrice4
                                    </span>

                                </td>

                            </tr>




                            <tr>

                                <th>
                                    Center Shape | Size
                                </th>


                                <td>
                                    @item.CenterShapeSize
                                </td>


                                <td>

                                    <span class="price-1">
                                        $@item.CenterPrice1
                                    </span>

                                    <span class="price-2">
                                        $@item.CenterPrice2
                                    </span>

                                    <span class="price-3">
                                        $@item.CenterPrice3
                                    </span>

                                    <span class="price-4">
                                        $@item.CenterPrice4
                                    </span>

                                </td>

                            </tr>




                            <tr>

                                <th>Total Weight</th>


                                <td>
                                    @item.TotalWeight
                                </td>


                                <td>

                                    <span class="price-1">
                                        @((item.SemiPrice1 + item.CenterPrice1)
                                    ?.ToString("C", new CultureInfo("en-US")))
                                    </span>


                                    <span class="price-2">
                                        @((item.SemiPrice1 + item.CenterPrice1)
                                    ?.ToString("C", new CultureInfo("en-US")))
                                    </span>


                                    <span class="price-3">
                                        @((item.SemiPrice1 + item.CenterPrice1)
                                    ?.ToString("C", new CultureInfo("en-US")))
                                    </span>


                                    <span class="price-4">
                                        @((item.SemiPrice1 + item.CenterPrice1)
                                    ?.ToString("C", new CultureInfo("en-US")))
                                    </span>


                                </td>


                            </tr>




                            <tr>

                                <th>Finding</th>

                                <td colspan="2"
                                    style="word-break:break-word;">


                                    @if (!string.IsNullOrEmpty(item.Findings))
                                    {

                                        var findings = item.Findings.Split('#');


                                        if (findings.Length > 1)
                                        {

                                            <ul class="mb-0 ps-3">

                                                @foreach (var f in findings)
                                                {
                                                    <li>
                                                        @f
                                                    </li>
                                                }

                                            </ul>

                                        }
                                        else
                                        {
                                            @item.Findings
                                        }

                                    }


                                </td>


                            </tr>



                            <tr>

                                <th>Collection</th>


                                <td colspan="2">
                                    @item.Collection
                                </td>


                            </tr>


                        </table>


                    </div>

                </div>

            }

        }
        else if (!string.IsNullOrEmpty(Request["company"])
            && !string.IsNullOrEmpty(Request["price"]))
        {
            <div class="col-12">

                <div class="alert alert-warning">
                    No Records Found
                </div>

            </div>
        }


    </div>
</div>

<style>
    .bootstrap-select .dropdown-menu li.selected:not(.active) a .text {
        color: #0d6efd !important;
    }

    .bootstrap-select .dropdown-menu .check-mark {
        color: #0d6efd !important;
    }

    .bootstrap-select .dropdown-menu li.active a .text,
    .bootstrap-select .dropdown-menu li.active a {
        color: #fff !important;
    }

        .bootstrap-select > .dropdown-toggle:focus {
            box-shadow: 0 0 0 .25rem rgba(13,110,253,.25) !important;
            border-color: #86b7fe !important;
        }
</style>


@section scripts
{
    <script>

        $(document).ready(function () {

            // Category / SubCategory / Collection - checkbox dropdowns
            $('#ddlCategory, #ddlSubCategory, #ddlCollection').selectpicker();

            var skuXhr = null;
            var skuSearchTimer = null;
            var skuRequestSeq = 0;
            var skuSearchBound = false;

            function initSkuPicker() {
                $('#ddlSku').selectpicker({
                    liveSearch: true,
                    title: 'Select SKU',
                    selectedTextFormat: 'count > 2',
                    width: '100%'
                });
            }

            initSkuPicker();

            function bindSkuSearch() {
                if (skuSearchBound) {
                    return;
                }
                skuSearchBound = true;

                $(document).on('keyup.skuSearch', '#ddlSku ~ .dropdown-menu .bs-searchbox input', function () {
                    var term = $(this).val();

                    clearTimeout(skuSearchTimer);

                    if (term.length < 5) {
                        return;
                    }

                    skuSearchTimer = setTimeout(function () {
                        fetchSkus(term);
                    }, 300);
                });
            }

            function fetchSkus(term) {

                var mySeq = ++skuRequestSeq;

                if (skuXhr) {
                    skuXhr.abort();
                }

                skuXhr = $.ajax({
                    url: '/api/sku/GetSkus',
                    type: 'GET',
                    dataType: 'json',
                    data: {
                        term: term,
                        company: $("#ddlCompany").val(),
                        category: $("#ddlCategory").val(),
                        subCategory: $("#ddlSubCategory").val(),
                        collection: $("#ddlCollection").val()
                    },
                    success: function (data) {

                        // Ignore this response if a newer search has started since
                        if (mySeq !== skuRequestSeq) {
                            return;
                        }

                        var selected = $('#ddlSku').val() || [];
                        var seen = {};
                        var html = '';

                        $.each(selected, function (i, val) {
                            if (!seen[val]) {
                                seen[val] = true;
                                html += '<option value="' + val + '" selected>' + val + '</option>';
                            }
                        });

                        $.each(data, function (i, item) {
                            if (!seen[item.Value]) {
                                seen[item.Value] = true;
                                html += '<option value="' + item.Value + '">' + item.Text + '</option>';
                            }
                        });

                        // Fully tear down and rebuild - avoids stale internal
                        // list state that 'refresh' can leave behind
                        $('#ddlSku').selectpicker('destroy');
                        $('#ddlSku').html(html);
                        initSkuPicker();

                        $('#ddlSku').selectpicker('toggle');

                        var $newSearch = $('#ddlSku ~ .dropdown-menu .bs-searchbox input');
                        $newSearch.val(term);
                        $newSearch.focus();
                        if ($newSearch.length) {
                            $newSearch[0].setSelectionRange(term.length, term.length);
                        }

                        bindSkuSearch();
                    }
                });
            }

            $('#ddlSku').on('shown.bs.select', bindSkuSearch);
            $(document).on('changed.bs.select', '#ddlSku', updatePdfUrl);


            // Cascading clear: each level only clears the next one to its right.
            $("#ddlCompany").on('change', function () {
                $("#ddlCategory").selectpicker('val', []);
                applyPriceFilter();
                //resetPriceDefault();
                checkSearchButton();
                updatePdfUrl();

            });

            $("#ddlCategory").on('changed.bs.select', function () {
                $("#ddlSubCategory").selectpicker('val', []);
                resetPriceDefault();
                updatePdfUrl();
            });

            $("#ddlSubCategory").on('changed.bs.select', function () {
                $("#ddlCollection").selectpicker('val', []);
                resetPriceDefault();
                updatePdfUrl();
            });

            $("#ddlCollection").on('changed.bs.select', function () {
                $("#ddlSku").selectpicker('val', []);
                resetPriceDefault();
                updatePdfUrl();
            });
            $(document).on('changed.bs.select', '#ddlSku', function () {
                resetPriceDefault();
                updatePdfUrl();
            });

            // Price
            $("#ddlPrice").on('change', function () {
                applyPriceFilter();
                checkSearchButton();
                updatePdfUrl();
            });


            applyPriceFilter();
            checkSearchButton();
            updatePdfUrl();

            if ($("#ddlCompany").val() != ""
                && $("#ddlPrice").val() != ""
                && $(".card").length > 1) {

                $("#btnPdf")
                    .removeClass("disabled");
            }

        });

    //
    function applyPriceFilter() {

    var price = $("#ddlPrice").val();

    $(".price-1,.price-2,.price-3,.price-4").hide();

    if (price != "") {
        $(".price-" + price).show();
    }

    checkSearchButton();
}


    function checkSearchButton() {

        $("#btnSearch").prop(
            "disabled",
            $("#ddlCompany").val() == ""
            || $("#ddlPrice").val() == ""
        );
    }


    function updatePdfUrl() {

        var url =
            '@Url.Action("ThumbnailProposalReportPdf", "Report")'
            + '?'
            + $.param({
                company: $("#ddlCompany").val(),
                category: $("#ddlCategory").val(),
                subCategory: $("#ddlSubCategory").val(),
                collection: $("#ddlCollection").val(),
                skus: $("#ddlSku").val() || [],
                price: $("#ddlPrice").val()
            }, true);

        $("#btnPdf")
            .attr("href", url);
    }

        $('form').submit(function (e) {

            e.preventDefault();

            $.ajax({
                url: $(this).attr('action'),
                type: 'GET',
                data: $(this).serialize(),
                traditional: true,

                success: function (response) {

                    var html =
                        $('<div>')
                            .html(response)
                            .find('#reportContainer')
                            .html();

                    $('#reportContainer')
                        .html(html);

                    applyPriceFilter();

                    if ($(".card").length > 0) {
                        $("#btnPdf")
                            .removeClass("disabled");
                    }
                    else {
                        $("#btnPdf")
                            .addClass("disabled");
                    }
                }
            });
        });
        function resetPriceDefault() {
            //$("#ddlPrice").val("");
            //applyPriceFilter();
            //checkSearchButton();
        }
    </script>
}