@using System.Reflection
@using System.Collections

@model dynamic

@{
    ViewBag.Title = "Import Summary";

    object firstItem = null;

    foreach (var item in Model.InvalidRecords)
    {
        firstItem = item;
        break;
    }

    if (firstItem == null)
    {
        foreach (var item in Model.DuplicateRecords)
        {
            firstItem = item;
            break;
        }
    }

    if (firstItem == null)
    {
        foreach (var item in Model.ValidRecords)
        {
            firstItem = item;
            break;
        }
    }

    List<PropertyInfo> properties = new List<PropertyInfo>();

    if (firstItem != null)
    {
        properties = firstItem.GetType()
            .GetProperties()
            .Where(delegate (PropertyInfo p)
            {
                return
                    p.Name != "IsValid" &&
                    p.Name != "IsDuplicate" &&
                    p.Name != "ErrorMessage1" &&
                    p.Name != "ErrorMessage2";
            })
            .ToList();
    }
}

<style>
    .custom-scroll-grid {
        max-height: 350px;
        overflow-y: auto;
        overflow-x: auto;
    }

        .custom-scroll-grid table {
            margin-bottom: 0;
        }

        .custom-scroll-grid thead th {
            position: sticky;
            top: 0;
            z-index: 2;
        }
</style>

<div class="container mt-4">

    <div class="card shadow">

        <a href="@Url.Action("Upload","Import")"
           class="btn btn-secondary">
            Back
        </a>

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                Import Summary of :
                <span class="fw-bold">
                    @TempData["master"]
                </span>
            </h4>
        </div>

        <div class="card-body">

            <div class="row text-center mb-4">

                <div class="col-md-3">
                    <div class="card border-primary">
                        <div class="card-body">
                            <h5>Total Rows</h5>
                            <h3 class="text-primary">
                                @Model.TotalRows
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-success">
                        <div class="card-body">
                            <h5>Valid Rows</h5>
                            <h3 class="text-success">
                                @Model.ValidRows
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-warning">
                        <div class="card-body">
                            <h5>Duplicate Rows</h5>
                            <h3 class="text-warning">
                                @Model.DuplicateRows
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-danger">
                        <div class="card-body">
                            <h5>Invalid Rows</h5>
                            <h3 class="text-danger">
                                @Model.InvalidRows
                            </h3>
                        </div>
                    </div>
                </div>

            </div>

            @if (Model.InvalidRecords.Count > 0)
            {
                <div class="card mb-4 border-danger">

                    <div class="card-header bg-danger text-white">
                        Invalid Records
                    </div>

                    <div class="card-body table-responsive custom-scroll-grid">

                        <table class="table table-bordered table-striped">

                            <thead class="table-dark">

                                <tr>

                                    @foreach (var prop in properties)
                                    {
                                        <th>@prop.Name</th>
                                    }

                                    <th>Error</th>

                                </tr>

                            </thead>

                            <tbody class="bg-info">

                                @foreach (var item in Model.InvalidRecords)
                                {
                                    <tr>

                                        @foreach (var prop in properties)
                                        {
                                            <td>
                                                @prop.GetValue(item)
                                            </td>
                                        }

                                        <td class="text-danger fw-bold">
                                            @item.ErrorMessage1
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>
            }

            @if (Model.DuplicateRecords.Count > 0)
            {
                <div class="card mb-4 border-warning">

                    <div class="card-header bg-warning text-dark">
                        Duplicate Records
                    </div>

                    <div class="card-body table-responsive custom-scroll-grid">

                        <table class="table table-bordered table-striped">

                            <thead class="table-dark">

                                <tr>

                                    @foreach (var prop in properties)
                                    {
                                        <th>@prop.Name</th>
                                    }

                                    <th>Error</th>

                                </tr>

                            </thead>

                            <tbody class="bg-info">

                                @foreach (var item in Model.DuplicateRecords)
                                {
                                    <tr>

                                        @foreach (var prop in properties)
                                        {
                                            <td>
                                                @prop.GetValue(item)
                                            </td>
                                        }

                                        <td class="text-danger fw-bold">
                                            @item.ErrorMessage2
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>
            }

            @if (Model.ValidRows > 0)
            {
                <div class="alert alert-success">

                    <h5 class="mb-3">
                        Records are ready for import.
                    </h5>

                    <form id="confirmForm"
                          method="post"
                          action="@Url.Action("ConfirmImport","Import")">

                        <button type="submit"
                                class="btn btn-success">

                            <i class="fa fa-check"></i>

                            Continue Import Valid @Model.ValidRows Records

                        </button>

                        <a href="@Url.Action("Upload","Import")"
                           class="btn btn-secondary">

                            Cancel

                        </a>

                    </form>

                </div>
            }

        </div>

    </div>

</div>

<div id="loaderOverlay"
     class="position-fixed top-0 start-0 w-100 h-100 d-none align-items-center justify-content-center"
     style="background:rgba(0,0,0,0.55);z-index:9999;">

    <div class="bg-white rounded-3 p-4 d-flex flex-column align-items-center gap-3"
         style="min-width:220px;">

        <div class="spinner-border text-primary"
             style="width:3rem;height:3rem;"
             role="status">

            <span class="visually-hidden">
                Loading...
            </span>

        </div>

        <div id="loaderLabel"
             class="fw-medium fs-6 text-dark">
        </div>

        <div id="loaderSub"
             class="text-muted small">
        </div>

    </div>

</div>

<script>
    document.getElementById('confirmForm')
        .addEventListener('submit', function () {

            var overlay =
                document.getElementById('loaderOverlay');

            document.getElementById('loaderLabel')
                .textContent = 'Importing records...';

            document.getElementById('loaderSub')
                .textContent =
                'Saving valid records to the database';

            overlay.classList.remove('d-none');

            overlay.classList.add('d-flex');
        });
</script>

