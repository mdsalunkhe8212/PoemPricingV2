@model POEM.Model.Model.Import.ImportRequestDto
@{
    ViewBag.Title = "Bulk Import";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">

                <div class="card-header bg-light text-dark">
                    <h4 class="mb-0">Bulk Excel Import</h4>
                </div>

                <div class="card-body">

                    @* ERROR ALERT *@
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["Error"]
                        </div>
                    }

                    @* SUCCESS MODAL *@
                    @if (TempData["Success"] != null)
                    {
                        <div class="modal fade" id="successModal" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title text-success">Success</h5>
                                        <button type="button"
                                                class="btn-close"
                                                data-bs-dismiss="modal">
                                        </button>
                                    </div>
                                    <div class="modal-body">
                                        @TempData["Success"]
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button"
                                                class="btn btn-primary"
                                                data-bs-dismiss="modal">
                                            Close
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <form id="uploadForm"
                          method="post"
                          action="@Url.Action("ValidateImport", "Import")"
                          enctype="multipart/form-data">

                        @* MASTER DROPDOWN *@
                        <div class="form-group mb-3">
                            <label class="form-label fw-bold">Select Master</label>
                            <div class="d-flex align-items-center gap-2">
                                <select id="masterType"
                                        name="MasterType"
                                        class="form-control">
                                    <option value="">-- Select Master --</option>
                                    <option value="CategoryDetails">Category Details</option>
                                    <option value="SubCategoryMaster">Sub Category Master</option>
                                    <option value="CollectionDetails">Collection Details</option>
                                    <option value="CompanyMaster">Company Master</option>
                                    <option value="FindingDetails">Finding Details</option>
                                    <option value="StoneShapeDetails">Stone Shape Details</option>
                                    <option value="StoneQualityDetails">Stone Quality Details</option>
                                    <option value="VendorDetails">Vendor Details</option>
                                    <option value="ProcessCostingDetails">Process Costing Details</option>
                                    <option value="SettingLaborDetails">Setting Labor Details</option>
                                    <option value="MarginDetails">Margin Details</option>
                                    <option value="DiamondDetails">Diamond Details</option>
                                    <option value="DutyChartMaster">Duty Chart Master</option>
                                    <option value="DutyDetails">Duty Details</option>
                                </select>

                                @* DB COUNT INFO *@
                                <span id="masterInfo"
                                      class="text-muted small text-nowrap d-none">
                                </span>
                            </div>
                        </div>

                        @* FILE INPUT *@
                        <div class="form-group mb-4">
                            <label class="form-label fw-bold">Select Excel File</label>
                            <input type="file"
                                   id="excelFile"
                                   name="File"
                                   class="form-control" />
                            <small class="text-muted">Upload .xlsx file only</small>
                        </div>

                        @* ACTION BUTTONS *@
                        <div class="text-end d-flex justify-content-end gap-2">
                            <button type="button"
                                    id="exportExcelBtn"
                                    class="btn btn-primary"
                                    disabled>
                                <i class="fa fa-file-excel-o"></i>
                                Export
                            </button>

                            <button type="submit"
                                    id="submitBtn"
                                    class="btn btn-success"
                                    disabled>
                                <i class="fa fa-upload"></i>
                                Validate Import
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@* LOADER OVERLAY *@
<div id="loaderOverlay"
     class="position-fixed top-0 start-0 w-100 h-100 d-none align-items-center justify-content-center"
     style="background:rgba(0,0,0,0.55);z-index:9999;">
    <div class="bg-white rounded-3 p-4 d-flex flex-column align-items-center gap-3"
         style="min-width:220px;">
        <div class="spinner-border text-primary"
             style="width:3rem;height:3rem;"
             role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <div id="loaderLabel" class="fw-medium fs-6 text-dark"></div>
        <div id="loaderSub" class="text-muted small"></div>
    </div>
</div>

<script>

    const masterType = document.getElementById('masterType');
    const excelFile  = document.getElementById('excelFile');
    const submitBtn  = document.getElementById('submitBtn');
    const exportBtn  = document.getElementById('exportExcelBtn');
    const masterInfo = document.getElementById('masterInfo');

    // ============================
    // Toggle submit button —
    // needs both master + file selected
    // ============================
    function toggleSubmit() {
        const isMasterSelected = masterType.value !== '';
        const isFileChosen     = excelFile.files.length > 0;
        submitBtn.disabled = !(isMasterSelected && isFileChosen);
    }

    excelFile.addEventListener('change', toggleSubmit);

    // ============================
    // Master dropdown change —
    // ONE listener handles everything:
    // toggle submit, fetch count, show/hide export + info
    // ============================
    masterType.addEventListener('change', function () {

        const selected     = this.value;
        const selectedText = this.options[this.selectedIndex].text;

        // Toggle submit button
        toggleSubmit();

        // Reset export + info
        exportBtn.disabled = true;
        exportBtn.innerHTML = '<i class="fa fa-file-excel-o"></i> Export';
        masterInfo.classList.add('d-none');
        masterInfo.innerHTML = '';

        // Nothing selected — stop here
        if (!selected) return;

        // Fetch count for info label only
        fetch('@Url.Action("GetExportCount", "Import")?masterType='
              + encodeURIComponent(selected))
            .then(response => response.json())
            .then(data => {

                // Enable export button — no count on button
                exportBtn.disabled = false;
                exportBtn.innerHTML = '<i class="fa fa-file-excel-o"></i> Export';

                // Show count info next to dropdown only
                masterInfo.innerHTML =
                    'DB Count: <strong>' + data.count + '</strong> ' + selectedText + ' records';
                masterInfo.classList.remove('d-none');
            })
            .catch(() => {
                // On error — still enable export, hide info
                exportBtn.disabled = false;
                exportBtn.innerHTML = '<i class="fa fa-file-excel-o"></i> Export';
                masterInfo.classList.add('d-none');
            });
    });

    // ============================
    // Export button click
    // ============================
    exportBtn.addEventListener('click', function () {
        const selected = masterType.value;
        if (!selected) return;
        window.location.href =
            '@Url.Action("ExportToExcel", "Import")?masterType='
            + encodeURIComponent(selected);
    });

    // ============================
    // Upload form loader
    // ============================
    document.getElementById('uploadForm').addEventListener('submit', function () {
        var overlay = document.getElementById('loaderOverlay');
        document.getElementById('loaderLabel').textContent = 'Validating file...';
        document.getElementById('loaderSub').textContent   = 'Reading and checking your Excel data';
        overlay.classList.remove('d-none');
        overlay.classList.add('d-flex');
    });

    // ============================
    // Show success modal if present
    // ============================
    document.addEventListener('DOMContentLoaded', function () {
        var modal = document.getElementById('successModal');
        if (modal) {
            new bootstrap.Modal(modal).show();
        }
    });

</script>
