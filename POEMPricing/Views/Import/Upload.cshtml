@model POEM.Model.Model.Import.ImportRequestDto
@{
    ViewBag.Title = "Bulk Import";
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        Bulk Excel Import
                    </h4>
                </div>
                <div class="card-body">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["Error"]
                        </div>
                    }
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["Success"]
                        </div>
                    }
                    <form id="uploadForm"
                          method="post"
                          action="@Url.Action("ValidateImport","Import")"
                          enctype="multipart/form-data">

                        <div class="form-group mb-3">
                            <label class="form-label fw-bold">
                                Select Master
                            </label>

                            <select id="masterType"
                                    name="MasterType"
                                    class="form-control">
                                <option value="">
                                    -- Select Master --
                                </option>
                                <option value="CategoryDetails">
                                    Category Details
                                </option>
                                <option value="SubCategoryMaster">
                                    Sub Category Master
                                </option>
                                <option value="CollectionDetails">
                                    Collection Details
                                </option>
                                <option value="CompanyMaster">
                                    Company Master
                                </option>
                                <option value="FindingDetails">
                                    Finding Details
                                </option>
                                <option value="StoneShapeDetails">
                                    Stone Shape Details
                                </option>
                                <option value="StoneQualityDetails">
                                    Stone Quality Details
                                </option>
                                <option value="SettingLaborDetails">
                                    Setting Labor Details
                                </option>
                                <option value="VendorDetails">
                                    Vendor Details
                                </option>
                            </select>
                        </div>

                        <div class="form-group mb-4">
                            <label class="form-label fw-bold">
                                Select Excel File
                            </label>

                            <input type="file"
                                   id="excelFile"
                                   name="File"
                                   class="form-control" />

                            <small class="text-muted">
                                Upload .xlsx file only
                            </small>
                        </div>

                        <div class="text-end">
                            <button type="submit"
                                    id="submitBtn"
                                    class="btn btn-success"
                                    disabled>
                                <i class="fa fa-upload"></i>
                                Validate Import
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="loaderOverlay"
     class="position-fixed top-0 start-0 w-100 h-100 d-none align-items-center justify-content-center"
     style="background:rgba(0,0,0,0.55);z-index:9999;">
    <div class="bg-white rounded-3 p-4 d-flex flex-column align-items-center gap-3"
         style="min-width:220px;">
        <div class="spinner-border text-primary"
             style="width:3rem;height:3rem;" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <div id="loaderLabel" class="fw-medium fs-6 text-dark"></div>
        <div id="loaderSub" class="text-muted small"></div>
    </div>
</div>

<script>
    const masterType = document.getElementById('masterType');
    const excelFile = document.getElementById('excelFile');
    const submitBtn = document.getElementById('submitBtn');

    function toggleButton() {
        const isMasterSelected = masterType.value !== '';
        const isFileChosen = excelFile.files.length > 0;

        submitBtn.disabled = !(isMasterSelected && isFileChosen);
    }

    masterType.addEventListener('change', toggleButton);
    excelFile.addEventListener('change', toggleButton);

    document.getElementById('uploadForm').addEventListener('submit', function () {

        var overlay = document.getElementById('loaderOverlay');

        document.getElementById('loaderLabel').textContent = 'Validating file...';

        document.getElementById('loaderSub').textContent =
            'Reading and checking your Excel data';

        overlay.classList.remove('d-none');
        overlay.classList.add('d-flex');
    });
</script>

